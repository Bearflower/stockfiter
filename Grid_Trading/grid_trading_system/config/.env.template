# 网格交易系统 - 环境变量模板
# 复制为 .env 并填入实际值

# ==================== 币安 API 配置 ====================
# 币安 API Key（必填）
BINANCE_API_KEY=your_api_key_here

# 币安 API Secret（必填）
BINANCE_API_SECRET=your_api_secret_here

# 是否使用测试网（true/false）
BINANCE_TESTNET=true

# ==================== 数据库配置 ====================
# 数据库类型（sqlite/mysql）
DB_TYPE=sqlite

# SQLite 数据库路径
DB_PATH=data/trading.db

# MySQL 配置（如果使用 MySQL）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=grid_trading

# ==================== 通知配置 ====================
# 飞书 Webhook URL
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_token

# ==================== 系统配置 ====================
# 运行模式（auto/signal）
SYSTEM_MODE=auto

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 配置文件路径
CONFIG_PATH=config/config.yaml
