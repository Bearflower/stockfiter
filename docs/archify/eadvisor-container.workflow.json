{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "stockfilter-eadvisor 容器 · E大估值策略日报流水线",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "docs/archify/eadvisor-container.html",
    "views": [
      {
        "id": "daily-route",
        "label": "每日日报主链路（LLM 决策）",
        "focus": [
          "tick",
          "fetch",
          "validate",
          "temperature",
          "llm_analysis",
          "opinion",
          "push"
        ],
        "note": "容器每天 23:10 触发：采集 → 温度 → LLM 综合分析（仓位+ETF+解读）→ 观点匹配 → 飞书日报。"
      },
      {
        "id": "fallback",
        "label": "规则引擎降级路径",
        "focus": [
          "llm_analysis",
          "position",
          "etf",
          "opinion"
        ],
        "note": "LLM 综合分析失败（API 异常/校验不过/无 key）时，降级到规则引擎：仓位映射 + ETF 买卖区比对。"
      },
      {
        "id": "data-approx",
        "label": "估值近似与降级",
        "focus": [
          "fetch",
          "validate",
          "klineFallback",
          "cache",
          "skip"
        ],
        "note": "分位用收盘价5年近似；无有效数据跳过当日推送。"
      }
    ]
  },
  "lanes": [
    {
      "id": "collect",
      "label": "调度与采集"
    },
    {
      "id": "decision",
      "label": "决策引擎"
    },
    {
      "id": "notify",
      "label": "通知"
    },
    {
      "id": "bypass",
      "label": "降级与旁路",
      "variant": "exception"
    }
