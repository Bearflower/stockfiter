      "id": "trigger",
      "label": "定时触发",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "collect",
      "label": "采集 + 校验",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    },
