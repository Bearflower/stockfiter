# 币安 API 配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 飞书通知配置（已废弃，使用通用通知服务）
# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_url

# 通用服务配置
KLINE_SERVICE_URL=http://43.156.242.184:8765/api/v1
NOTIFICATION_SERVICE_URL=http://43.156.242.184:8766/api/v1
NOTIFICATION_PROJECT=btc_eth_bnb

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# 系统配置
SYSTEM_NAME=Binance Trading System
SYSTEM_VERSION=1.0.0

# 自动交易开关
ENABLE_AUTO_TRADE=false

# 风险控制配置
RISK_LEVEL_LOW=0.2
RISK_LEVEL_MEDIUM=0.5
RISK_LEVEL_HIGH=0.8

# JWT 配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
