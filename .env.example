# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 飞书推送 Webhook URL
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token

# 数据库连接
DB_HOST=common_service_postgres
DB_PORT=5432
DB_NAME=stockfilter
DB_USER=stockfilter_user
# 数据库密码：必须设置，留空会导致 compose 启动失败（:?DB_PASSWORD must be set）
# 在服务器上通过 CI/CD secrets 或手动 export DB_PASSWORD=... 注入，
# 本地开发复制此文件为 .env 后填入真实密码
DB_PASSWORD=
DB_SCHEMA=schema_stockfilter

# 远程 K 线服务
KLINE_REMOTE_URL=http://43.156.242.184:8765/api/v1

# 日志级别
LOG_LEVEL=INFO