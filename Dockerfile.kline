FROM python:3.9-slim

WORKDIR /app

# 安装系统依赖和时区数据
RUN apt-get update && apt-get install -y \
    gcc \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# 设置时区为 Asia/Shanghai（北京时间）
ENV TZ=Asia/Shanghai
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    dpkg-reconfigure -f noninteractive tzdata

# 复制 K 线服务依赖
COPY requirements-kline.txt requirements.txt

# 安装 Python 依赖（不含 openai/openai，K 线服务不需要 LLM）
RUN pip install --no-cache-dir -r requirements.txt

# 复制 K 线服务所需代码
COPY data/ data/
COPY utils/ utils/
COPY scripts/data/update_kline_daily.py scripts/data/
COPY scripts/data/quick_backfill.py scripts/data/
COPY scripts/scheduler_kline.py scripts/
COPY config/ config/

# 创建数据目录
RUN mkdir -p logs data output && chmod -R 777 logs data output

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

CMD ["python", "-u", "-c", "import time; print('K线服务容器已启动，等待定时调度...'); [time.sleep(60) for _ in iter(int, 1)]"]